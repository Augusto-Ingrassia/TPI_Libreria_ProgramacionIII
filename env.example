# Variables de entorno — Servicio Backend (FastAPI + SQLModel + PostgreSQL)
# Formato: postgresql+asyncpg://<usuario>:<password>@<host_interno_postgres>:5432/<nombre_db>
DATABASE_URL=postgresql+asyncpg://postgres:cambiar_password@localhost:5432/libreria_db
SQL_ECHO=false
APP_PORT=8000
CORS_ORIGINS=*

# Variables de entorno — Servicio Frontend (Nginx Reverse Proxy)
# Formato: <host_interno_backend>:<puerto> (sin http:// ni barra final)
# En local con Docker Desktop: host.docker.internal:8000
# En Easypanel: <proyecto>_<servicio_backend>:8000
API_UPSTREAM=host.docker.internal:8000
